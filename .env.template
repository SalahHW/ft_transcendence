# ================================
# Service Hosts
# ================================

USERS_SERVICE_HOST=users                          # Hostname for the users service
PRESENCES_SERVICE_HOST=presences                  # Hostname for the presences service
JWT_SERVICE_HOST=jwt                              # Hostname for the jwt service 
FRIENDS_SERVICE_HOST=friends                      # Hostname for the friends service
AVATARS_SERVICE_HOST=avatars                      # Hostname for the avatars service

# ================================
# Service Ports
# ================================

USERS_SERVICE_PORT=3000                           # Port used by the users service
AVATARS_SERVICE_PORT=3004                         # Port used by the avatars service
JWT_SERVICE_PORT=3005                             # Port used by the JWT service
FRIENDS_SERVICE_PORT=3003                         # Port used by the friends service
BLOCKCHAIN_SERVICE_PORT=3001                      # Port used by the blockchain service
PRESENCES_SERVICE_PORT=3002                       # Port used by the presences service

# ================================
# Service URLs
# ================================

USERS_SERVICE_URL=http://users:3000               # Internal URL for the users service
AVATARS_SERVICE_URL=http://avatars:3001           # Internal URL for the avatars service
JWT_SERVICE_URL=http://jwt:3005                   # Internal URL for the JWT service
FRIENDS_SERVICE_URL=http://friends:3003           # Internal URL for the friends service
PRESENCES_SERVICE_URL=wss://presences:3002        # Internal URL for the presences service

# ================================
# Database Paths
# ================================

USERS_DB_PATH=/app/database/users.db              # Path to the users service database
AVATARS_DB_PATH=/app/database/avatars.db          # Path to the avatars service database
FRIENDSHIPS_DB_PATH=/app/database/friendships.db  # Path to the friends service database

# ================================
# Avatars Directory
# ================================

AVATARS_PATH=/app/avatars                         # Directory where uploaded avatars are stored
